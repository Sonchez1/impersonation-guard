{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true,
    "noEmit": true, "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["chrome"],
    "paths": { "@impersonation-guard/engine": ["../engine/src/index.ts"] }
  },
  "include": ["src/**/*.ts", "src/**/*.json"]
}
